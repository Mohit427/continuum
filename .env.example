# Copy to .env.local and fill in. Never commit .env.local.

# Supabase: Project Settings > API Keys (Data API)
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "anon" (legacy) or "publishable" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" (legacy) or "secret" key. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic: console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-opus-5-5

# OpenRouter (used instead of Anthropic when set): openrouter.ai > Keys
OPENROUTER_API_KEY=
# Any vision model with structured outputs, e.g. anthropic/claude-sonnet-5.5, google/gemini-3.8-flash
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Password for the demo accounts (seed + one-click demo logins)
DEMO_PASSWORD=Continuum@2026

# Public URL of the deployment (QR codes / share links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
